    "stipple": {"on": true, "density": 1.8, "near_p": 0.85, "far_p": 0.1, "gamma": 0.9,
                "max_samples": 90000, "cut_density": 2.4, "band_mm": 6.0, "max_cut_dots": 60000},
    "junction": {"on": false, "max_pairs": 3000},
    "live": {"boundary_width_scale": 2.0},
    "materials": {
      "*":                          {"fill": "white"},
      "Brick*":                     {"hatch": {"pattern": "MC Brick", "mm": 1.1}},
      "Mortar*":                    {"fill": "white"},
      "*Batt":                      {"batt": true},
      "Mineral Wool Board":         {"batt": true},
      "Rigid*":                     {"hatch": {"pattern": "MC Rigid", "mm": 1.3}},
      "Polyiso*":                   {"hatch": {"pattern": "MC Rigid", "mm": 1.3}},
