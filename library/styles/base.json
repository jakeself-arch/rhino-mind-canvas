      "OSB*":                       {"hatch": {"pattern": "MC Plywood", "mm": 0.8}},
      "Wood Framing":               {"cross": true},
      "Cold-Formed Steel":          {"fill": "black"},
      "Structural Steel":           {"fill": "black"},
      "Steel*":                     {"fill": "black"},
      "Flashing*":                  {"fill": "black"},
      "Brick Tie":                  {"fill": "black"},
      "Aluminum":                   {"fill": "black"},
      "Sealant":                    {"fill": "black"},
      "Weep Vent":                  {"fill": "grey", "grey": 0.45},
      "Weather Resistive Barrier":  {"fill": "black"},
      "Vapor Retarder":             {"fill": "black"},
      "Glass":                      {"fill": "black", "tone": false},
      "Spandrel Glass":             {"fill": "black"},
      "Gasket":                     {"fill": "black"},
      "Structural Silicone":        {"fill": "black"},
      "Setting Block":              {"fill": "black"},
      "Thermal Break":              {"fill": "grey", "grey": 0.5},
