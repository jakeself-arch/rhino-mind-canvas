      "Fire Safing":                {"batt": true},
      "Glulam":                     {"hatch": {"pattern": "MC Wood", "mm": 1.2}},
      "Wood Trim":                  {"tone": 2.5},
      "Concrete*":                  {"hatch": {"pattern": "MC Concrete", "mm": 3.0}},
      "Ground*":                    {"ground": true, "stipple": 2.4, "inner": false},
      "Earth*":                     {"ground": true, "stipple": 2.4, "inner": false},
      "Asphalt Shingles":           {"fill": "black"},
      "Roofing Underlayment":       {"fill": "black"},
      "Ice and Water Shield":       {"fill": "black"},
