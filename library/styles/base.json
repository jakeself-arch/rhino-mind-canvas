{
  "_comment": "Drawing style defaults inherited by every scale preset ('extends': 'base'). Widths are pen widths in paper mm at the near end of the depth range. 'order' is the painter's order. Material keys are names or fnmatch patterns ('Brick*'); the most specific match wins, merged over '*'. Hatch 'mm' = repeat on paper (MC patterns have a unit repeat). See docs/DRAWING.md.",

  "base": {
    "abstract": true,
    "scale": 48,
    "lod": "design",
    "cut_mode": "material",
    "page": {"margin_mm": 8, "max_mm": [1189, 841], "ground_margin_mm": 22, "png_px_per_mm": 8},
    "classes": {
      "cut":        {"w": 0.70, "order": 60},
      "cut_inner":  {"w": 0.25, "order": 55},
      "cut_hatch":  {"w": 0.08, "order": 50},
      "silhouette": {"w": 0.35, "order": 30},
      "edge":       {"w": 0.18, "order": 20},
      "entourage":  {"w": 0.2, "order": 25},
      "junction":   {"w": 0.18, "order": 20},
      "hidden":     {"w": 0.10, "order": 15, "dash": [0.9, 0.6]},
      "tone":       {"w": 0.07, "order": 10},
      "stipple":    {"w": 0.15, "order": 12}
    },
    "depth": {"width_far": 0.45, "grey_far": 0.55, "gamma": 0.85, "far_percentile": 0.92, "split_mm": 12},
    "min_part_mm": 0.5,
    "min_cut_mm": 0.8,
    "hidden_lines": false,
    "sun": [-0.55, -0.35, 0.76],
    "tone": {"on": true, "levels": [[-0.35, 0.45], [0.05, 0.8], [0.25, 1.4]], "min_mm": 0.3,
