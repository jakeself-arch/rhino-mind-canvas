{
  "_comment": "Brick veneer walls, layers EXTERIOR -> INTERIOR. The masonry layer lays individual bricks (options: brick, bond, joint, tooling, courses, weeps, top_course, face) and builds its own accessories: 'ties' (adjustable ties aligned to the studs behind it) and 'base' (through-wall flashing + ledge | shelf_angle, exterior-facing brick only). Brick 'extend_bottom' starts the coursing below the wall base, e.g. 8\" = 3 modular courses. Accessories can instead be given as assembly extras (components brick_ties / veneer_base).",

  "Ext - Brick Veneer / 6\" Metal Stud": {
    "kind": "wall",
    "default_height": "10'",
    "default_reference": "core_exterior",
    "layers": [
      {"name": "Brick Veneer",          "component": "masonry",  "material": "Brick - Red",               "thickness": "3-5/8",
       "options": {"brick": "modular", "bond": "running", "joint": "3/8", "tooling": "concave", "weeps": 24,
                   "ties": {"spacing_v": 16, "spacing_h": 24, "first": 16},
                   "base": {"support": "ledge", "material": "Flashing", "upturn": 8}}},
      {"name": "Air Space",             "component": "void",                                              "thickness": "2"},
      {"name": "Continuous Insulation", "component": "solid",    "material": "Mineral Wool Board",        "thickness": "2"},
      {"name": "WRB",                   "component": "membrane", "material": "Weather Resistive Barrier", "thickness": "1/32"},
      {"name": "Sheathing",             "component": "solid",    "material": "Exterior Gypsum Sheathing", "thickness": "5/8"},
      {"name": "Framing",               "component": "framing",  "material": "Cold-Formed Steel",         "thickness": "6", "core": true,
       "options": {"system": "metal", "spacing": 16, "cavity_fill": "Mineral Wool Batt"}},
      {"name": "Gypsum",                "component": "solid",    "material": "Gypsum Board",              "thickness": "5/8"}
    ]
  },

